            display: grid;
            grid-template-columns: repeat(2,1fr);
            gap: 20px;
            margin-top: 45px;
        }

        .contact-item {
            border-top: 1px solid rgba(255,255,255,.1);
            padding: 20px 0;
        }

        .contact-item small {
            display: block;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 9px;
            margin-bottom: 8px;
        }

        .contact-item a,
        .contact-item span {
            color: #ccc;
            text-decoration: none;
        }

        .contact-item a:hover {
            color: #ffbd39 !important;
        }


