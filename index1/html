           FOOTER
        ===================================================== */

        .simple-footer {
            text-align: center;
            padding: 50px 20px;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        .simple-footer p {
            color: #555;
            font-size: 11px;
        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 991px) {

            .research-layout {
                grid-template-columns: 1fr;
                padding: 70px 25px;
                gap: 40px;
            }

            .research-sidebar {
                position: relative;
                top: 0;
            }

            .research-sidebar-card {
                border-left: none;
                border-bottom: 1px solid rgba(255,255,255,.1);
                padding-left: 0;
                padding-bottom: 25px;
            }

            .sidebar-nav {
                display: flex;
                flex-wrap: wrap;
                gap: 15px;
            }

            .sidebar-nav a {
                padding: 3px 0;
            }

            .profile-image {
                width: 180px;
            }

        }


        @media (max-width: 768px) {

            .hero-title {
                letter-spacing: -2px;
            }

            .hero-description {
                font-size: 16px;
            }

            .profile-grid,
            .thinking-grid,
            .servzit-layout,
            .contact-grid {
                grid-template-columns: 1fr;
            }

            .concept-flow {
                grid-template-columns: 1fr 1fr;
            }

            .research-section {
                padding: 65px 0;
            }

            .experimental-box {
                padding: 25px;
            }

        }


        @media (max-width: 480px) {

            .research-layout {
                padding: 60px 18px;
            }

            .concept-flow {
                grid-template-columns: 1fr;
            }

            .capability {
                display: block;
            }

            .capability-number {
                display: block;
                margin-bottom: 8px;
            }

        }


        /* =====================================================
           SHINE
        ===================================================== */

        .shining-text1 {
            font-size: 14px;
            color: #ddd;
            background:
                linear-gradient(
                    120deg,
                    #f6f6f6,
                    #ffffff,
                    #d19a00
                );
            background-size: 200% auto;
            background-clip: text;
            -webkit-background-clip: text;
            text-fill-color: transparent;
            -webkit-text-fill-color: transparent;
            animation: metallic-shine 3s linear infinite;
        }

        @keyframes metallic-shine {

            0% {
                background-position: 200% 50%;
            }

            100% {
                background-position: 0% 50%;
            }

        }


        /* =====================================================
           FADE
        ===================================================== */

        @keyframes sectionReveal {

            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }


    </style>

