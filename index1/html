            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 10px;
            margin-top: 35px;
        }

        .concept-step {
            padding: 20px;
            border: 1px solid rgba(255,255,255,.08);
            text-align: center;
        }

        .concept-step strong {
            display: block;
            color: #ddd;
            margin-bottom: 5px;
        }

        .concept-step span {
            color: #666;
            font-size: 11px;
        }


